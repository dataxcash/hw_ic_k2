+class _PairClearField:
+    """把一条已解折线当作**对网障碍**的场包装（对级耦合用；净空默认 0.1mm）。
+
+    只做几何：`obstacles` 透传（可见性图节点仍由原场生成），`seg_ok`/`point_ok`
+    追加『到保留折线距离 >= clr』。零项目特判。
+    """
+
+    def __init__(self, base, poly, clr: float = 0.1):
+        self._b = base
+        self._poly = [tuple(x) for x in poly]
+        self._clr = clr
+
+    @property
+    def obstacles(self):
+        return self._b.obstacles
+
+    def __getattr__(self, k):
+        return getattr(self._b, k)
+
+    def _d_seg(self, a, b) -> float:
+        return min(_seg_seg_dist(tuple(a), tuple(b), self._poly[i], self._poly[i + 1])
+                   for i in range(len(self._poly) - 1))
+
+    def _d_pt(self, p) -> float:
+        return min(_point_seg_dist(tuple(p), self._poly[i], self._poly[i + 1])
+                   for i in range(len(self._poly) - 1))
+
+    def seg_ok(self, net, a, b):
+        if not self._b.seg_ok(net, a, b):
+            return False
+        return self._d_seg(a, b) >= self._clr - 1e-9
+
+    def point_ok(self, net, p):
+        if not self._b.point_ok(net, p):
+            return False
+        return self._d_pt(p) >= self._clr - 1e-9
+
