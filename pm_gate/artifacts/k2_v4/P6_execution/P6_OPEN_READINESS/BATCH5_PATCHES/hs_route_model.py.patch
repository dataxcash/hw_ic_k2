+# ── ④ 退化守卫（批 5）──────────────────────────────────────────────────
+_SEG_DEGENERATE_EPS = 1e-6
+
+
+def _seg_len(a, b) -> float:
+    return math.hypot(b[0] - a[0], b[1] - a[1])
+
+
+def _polyline_degenerate(pts) -> bool:
+    """折线是否含**零长段**（相邻同点）。零长走线不可制造 ⇒ 引擎产出的任何
+    折线都不得含零长段（fail-closed）。已实测 `_tpl_a_line` 的 `ady<1e-9`
+    捷径在 `pad_x==corr_x ∧ pad_y==track` 时产出 `[(x,y),(x,y)]` 且通过
+    seg_ok/verify（K1 `OCuLink_RX0 left`）。通用性：只判几何，零项目特判。"""
+    q = list(pts)
+    return any(_seg_len(a, b) <= _SEG_DEGENERATE_EPS for a, b in zip(q, q[1:]))
+
