 "artifact": "k2_means_start_side_plan_v1",
 "ts": "2026-09-30",
 "authority": "#K2-454 sec.2.5 items 1-3 (one capability window, zero exam runs, + conditional N=1) + sec.16.3 + sec.13.",
 "sec16_3_four_elements": {
  "1_one_line_cause_of_death": "the previous means (allocation/order) is measured NON-BINDING: R1430 showed the guidance was consumed (segs 1152->636) while C1 stayed 2. The binding constraint is ENDPOINT START-NODE REACHABILITY: 267 of 268 blocks are no-free-start-node and 265 of them have BOTH representative ends OUTSIDE the C35 wall, so the maze is asked to start on copper it is forbidden to enter (the wall is applied inside the search loop by design, #K2-378/R1020); the existing port retry still passes that outside point as one of the two ends, so both retry directions are doomed.",
  "2_verified_fact_list": [
   "R1430: 268 unreachable entries; (pa_in,pb_in) = (False,False) x265, (False,True) x3, (True,True) x0 => EVERY blocked edge has at least one end outside the wall.",
   "R1430: endpoint_own_cell_hits = 23 of 281 failed edges (the D1 own-cell relaxation covers only inside-the-frame masking).",
   "R1430: the port lever WORKS whenever an end is inside (13 x reachable_via_port, e.g. via [51.5, 50.4375]).",
   "This window: the start-side substitution is a pure deterministic function (zero search); wall/gates/maze core untouched; the unit RED->GREEN reproduces the lesion (outside-the-wall start => snap_node None; the dR port cell => astar ok); selftest 144/144 PASS."
  ],
  "3_corrected_complete_construction_drawing": {
   "the_rule": "for any edge whose representative endpoint lies outside the frame, the router is asked as \"the net dR PORT <-> the other end\" (nearest port by L1 distance, tie-break (x,y,layer,uuid)). Nothing is drawn, moved or retired on the board: the outside copper is ALREADY kept by the wipe and its port IS the connection point, so the rule only changes WHICH existing copper point the router starts from.",
   "coverage_read_from_the_real_precheck": "blocked edges with an outside end: 547 (by net: {'GND': 487, 'P3V3': 42, 'MCU_VDD': 8, 'P3V3_AUX': 3, 'I2C2_SCL': 1, 'NRST': 1}); a concrete port was available for 504 of them => 92% of the class is mechanically addressable today.",
   "per_port_conservation": "the port set is the wipe ledger itself (outside_halves_kept = 15, n_ports = 15): one port per kept outside half. Each substituted edge consumes exactly one EXISTING port point - no new hole, no new layer, no new via class.",
   "layers": "F.Cu / In2.Cu / In5.Cu / B.Cu unchanged; span-aware via classes and the seg_exact/via_exact release gates UNCHANGED (the substitution only supplies a different start/goal point)."
  },
  "4_buildability": "no_move",
  "buildability_plain": "the means adds no board geometry - it is a router start-policy rule. Frozen four sources untouched; nothing lands until an authorised run says so."
 },
